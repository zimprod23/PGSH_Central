{
  "realm": "pgsh",
  "enabled": true,
  "displayName": "PGSH — Stages Hospitaliers",
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "bruteForceProtected": false,
  "accessTokenLifespan": 1800,
  "ssoSessionIdleTimeout": 7200,
  "ssoSessionMaxLifespan": 36000,
  "roles": {
    "realm": [
      {
        "name": "Student",
        "description": "Étudiant — son propre dossier."
      },
      {
        "name": "Scolarite",
        "description": "Service de scolarité — administratif, portée globale."
      },
      {
        "name": "Secretaire",
        "description": "Secrétaire de service — présences, limité aux services dont elle est staff."
      },
      {
        "name": "Professor",
        "description": "Professeur / chef de service — évalue les rotations de ses services."
      },
      {
        "name": "Employee",
        "description": "Personnel, sans portée administrative."
      },
      {
        "name": "SuperUser",
        "description": "Administrateur de l'application."
      }
    ]
  },
  "clients": [
    {
      "clientId": "pgsh-frontend",
      "name": "PGSH Frontend (React)",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "implicitFlowEnabled": false,
      "protocol": "openid-connect",
      "rootUrl": "http://localhost:5173",
      "baseUrl": "/",
      "redirectUris": [
        "http://localhost:5173/*",
        "https://localhost:7014/*",
        "http://localhost:5199/*"
      ],
      "webOrigins": [
        "+"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:5173/*##https://localhost:7014/*##http://localhost:5199/*"
      }
    }
  ],
