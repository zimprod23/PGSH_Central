{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "TodoDatabase": "Host=localhost;Database=test"
  },
  "Backups": {
    "_comment": "Dossier par defaut : %LOCALAPPDATA%/PGSH/backups — hors du depot et hors du volume pgsh-postgres-data. Le conteneur Postgres est decouvert via docker ps ; renseignez ContainerName s'il ne commence pas par postgres.",
    "Schedule": {
      "Enabled": true,
      "IntervalMinutes": 60,
      "KeepHourlyForHours": 24,
      "KeepDailyForDays": 30
    },
    "KeycloakRealmCovered": false
  },
  "Jwt": {
    "Secret": "demo",
    "Issuer": "",
    "Audience": "account",
    "ExpirationInMinutes": 10
  }
}
